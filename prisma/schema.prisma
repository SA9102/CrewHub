generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  OWNER
}

model User {
  id        String @id @default(uuid())
  firstName String
  lastName  String
  email     String @unique
  password  String

  role Role @default(USER)

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
}

model Organisation {
  id   String @id @default(uuid())
  name String

  users User[]
}

model InviteLink {
  id String @id @default(uuid())

  // Don't set email to unique. An admin should be allowed to send another
  // invite link to an email address if the previous one has expired.
  // But it is possible that an expired link may not be removed the DB.
  email   String
  expires BigInt
}
