generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  OWNER
}

model User {
  id        String @id @default(uuid())
  firstName String
  lastName  String
  email     String @unique
  password  String

  role Role @default(USER)

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  teams UsersOnTeams[]
}

model Organisation {
  id   String @id @default(uuid())
  name String

  users        User[]
  inviteTokens InviteToken[]
  teams        Team[]
}

model InviteToken {
  id String @id @default(uuid())

  token          String       @unique
  // Don't set email to unique. An admin should be allowed to send another
  // invite link to an email address if the previous one has expired.
  // But it is possible that an expired link may not be removed the DB.
  email          String
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  expires        BigInt
}

model Team {
  id             String         @id @default(uuid())
  name           String
  users          UsersOnTeams[]
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id])
}

model UsersOnTeams {
  user   User   @relation(fields: [userId], references: [id])
  userId String
  team   Team   @relation(fields: [teamId], references: [id])
  teamId String

  @@id([userId, teamId])
}
