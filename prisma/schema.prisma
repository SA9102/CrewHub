generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  OWNER
}

model User {
  id        String @id @default(uuid())
  firstName String
  lastName  String
  email     String @unique
  password  String

  role Role @default(USER)

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  teams  UsersOnTeams[]
  events Event[]

  privateChatsAsUser1 PrivateChat[] @relation("PrivateChatUser1")
  privateChatsAsUser2 PrivateChat[] @relation("PrivateChatUser2")

  messages Message[]
}

model Organisation {
  id   String @id @default(uuid())
  name String

  users        User[]
  inviteTokens InviteToken[]
  teams        Team[]
}

model InviteToken {
  id String @id @default(uuid())

  token          String       @unique
  // Don't set email to unique. An admin should be allowed to send another
  // invite link to an email address if the previous one has expired.
  // But it is possible that an expired link may not be removed the DB.
  email          String
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  expires        BigInt
}

model Team {
  id             String         @id @default(uuid())
  name           String
  users          UsersOnTeams[]
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id])
  events         Event[]
}

model UsersOnTeams {
  user   User   @relation(fields: [userId], references: [id])
  userId String
  team   Team   @relation(fields: [teamId], references: [id])
  teamId String

  @@id([userId, teamId])
}

model Event {
  id          String   @id @default(uuid())
  name        String
  description String
  start       DateTime
  end         DateTime

  organiserId String
  user        User   @relation(fields: [organiserId], references: [id])
  teamId      String
  team        Team   @relation(fields: [teamId], references: [id])
}

model PrivateChat {
  id      String @id @default(uuid())
  user1Id String
  user2Id String
  user1   User   @relation("PrivateChatUser1", fields: [user1Id], references: [id])
  user2   User   @relation("PrivateChatUser2", fields: [user2Id], references: [id])

  messages Message[]

  @@unique([user1Id, user2Id])
}

model Message {
  id      String      @id @default(uuid())
  content String
  sentBy  String
  user    User        @relation(fields: [sentBy], references: [id])
  chatId  String
  chat    PrivateChat @relation(fields: [chatId], references: [id])
}
